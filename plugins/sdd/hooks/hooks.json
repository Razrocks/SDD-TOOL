{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/session_rules.py"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/sdd_status.py", "refresh"],
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/sdd_status.py", "inject"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/hook_lock_gate.py"],
            "timeout": 10,
            "statusMessage": "Checking lock gate"
          }
        ]
      },
      {
        "matcher": "mcp__.*linear-drafts__save_document",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/hook_doc_writes.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
